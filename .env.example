# Copy to .env. Every value here is the default; nothing is required to run.

# Ports (read by the Makefile and the web dev server)
WEB_PORT=4104
# The web server listens on localhost only. Set 0.0.0.0 to reach it from another device;
# there are no accounts, so anyone who can reach it can read the journal.
WEB_HOST=127.0.0.1
API_PORT=8104
DB_PORT=5504

# Where the web server finds the API. Defaults to http://127.0.0.1:$API_PORT.
# DREAMLOG_API_URL=http://127.0.0.1:8104

# Postgres with pgvector
DREAMLOG_DATABASE_URL=postgresql://dreamlog:dreamlog@127.0.0.1:5504/dreamlog
DREAMLOG_TEST_DATABASE_URL=postgresql://dreamlog:dreamlog@127.0.0.1:5504/dreamlog_test

# Local object store (audio, pictures, posters) and the generated dev key
DREAMLOG_DATA_DIR=./data
DREAMLOG_MODEL_CACHE_DIR=./.cache/models

# Encryption at rest. Base64 of 32 random bytes: `python -m dreamlog.cli key` prints one.
# Empty means a key is generated into DREAMLOG_DATA_DIR/dev.key on first run.
DREAMLOG_ENCRYPTION_KEY=

# Audio is deleted as soon as it is transcribed unless this is true.
DREAMLOG_KEEP_AUDIO=false

# Speech to text: faster-whisper (local) or fake (tests)
DREAMLOG_TRANSCRIBER=faster-whisper
DREAMLOG_WHISPER_MODEL=base.en
DREAMLOG_WHISPER_COMPUTE_TYPE=int8

# Embeddings: fastembed (local MiniLM through ONNX Runtime) or hash (tests)
DREAMLOG_EMBEDDER=fastembed
DREAMLOG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DREAMLOG_CANONICAL_THRESHOLD=0.60

# Symbols and moods: auto, lexicon or anthropic. auto uses Claude when ANTHROPIC_API_KEY is set.
# With Claude the transcript is sent to Anthropic.
DREAMLOG_EXTRACTOR=auto
DREAMLOG_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Pictures: auto, procedural or api. auto uses the image API when DREAMLOG_IMAGE_API_KEY is set.
# With the API, symbol names and the mood are sent out. The transcript is not.
DREAMLOG_ILLUSTRATOR=auto
DREAMLOG_IMAGE_API_URL=https://api.openai.com/v1/images/generations
DREAMLOG_IMAGE_API_KEY=
DREAMLOG_IMAGE_MODEL=gpt-image-1

# Search
DREAMLOG_SEARCH_LIMIT=10
DREAMLOG_SEARCH_FLOOR=0.2
